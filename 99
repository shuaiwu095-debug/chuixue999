<!doctype html>
<html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no"><meta name="theme-color" content="#071426"><title>霓虹疾行 · Neon Dash</title>
<style>
*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#06101f;color:#fff;font-family:system-ui,sans-serif;touch-action:none}#wrap{position:relative;width:100%;height:100%;max-width:1100px;margin:auto}canvas{width:100%;height:100%;display:block}.hud{position:absolute;inset:0;padding:16px;display:flex;flex-direction:column;justify-content:space-between;pointer-events:none}.top{display:flex;justify-content:space-between;gap:8px}.pill{padding:9px 12px;border:1px solid #72edff55;border-radius:14px;background:#071426bb;font-weight:800}.brand{color:#4df4ff;letter-spacing:2px}.small{font-size:10px;color:#b6d7e8;letter-spacing:1px}.stat{font-size:20px}.hint{text-align:center;font-size:12px;text-shadow:0 2px 8px #000}button{font:inherit;font-weight:800;cursor:pointer;touch-action:manipulation}.overlay{position:absolute;inset:0;display:grid;place-items:center;padding:20px;background:#06101f8c}.panel{width:min(440px,100%);padding:25px 22px;text-align:center;border:1px solid #68eaff66;border-radius:24px;background:linear-gradient(145deg,#102c48f5,#081426f5);box-shadow:0 0 50px #24d9ff20}.kicker{color:#4df4ff;font-size:12px;font-weight:900;letter-spacing:4px}h1{font-size:clamp(34px,8vw,54px);line-height:1;margin:14px 0 8px;text-shadow:0 0 20px #39dfff65}.sub{color:#bfd7e6;font-size:14px;line-height:1.65;margin:16px auto;max-width:330px}.keys{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin:18px 0}.keys div{background:#ffffff0b;border-radius:12px;padding:10px 3px;font-size:11px;color:#d6efff}.keys b{display:block;font-size:20px;color:#ffd76a}.primary{width:100%;padding:15px;border:0;border-radius:14px;color:#06101f;background:linear-gradient(90deg,#4df4ff,#8bffdc)}.secondary{margin-top:10px;padding:10px 14px;border-radius:12px;color:#d6faff;background:#ffffff10;border:1px solid #ffffff22}.hidden{display:none!important}#pause{pointer-events:auto;align-self:flex-end;color:white;background:#071426bb;border:1px solid #72edff55;border-radius:10px;padding:7px 10px}#controls{position:absolute;bottom:10%;left:0;right:0;display:flex;justify-content:space-between;padding:0 7%;pointer-events:none}#controls button{pointer-events:auto;width:54px;height:54px;border-radius:50%;border:1px solid #9bf8ff70;background:#07142699;color:white;font-size:22px}#controls .group{display:flex;gap:8px}@media(pointer:fine){#controls{opacity:.25}}@media(max-height:500px){.panel{padding:12px}.sub{margin:8px auto}.keys{margin:8px 0}h1{font-size:34px}}
</style></head><body><div id="wrap"><canvas id="game"></canvas>
<div class="hud"><div class="top"><div class="pill"><div class="brand">✦ NEON DASH</div><div class="small">霓虹疾行</div></div><div style="display:flex;gap:7px"><div class="pill stat"><div class="small">距离</div><span id="score">0</span></div><div class="pill stat"><div class="small">金币</div><span id="coins">0</span> <span style="color:#ffd76a">◆</span></div></div></div><button id="pause" class="hidden">Ⅱ 暂停</button><div class="hint">← → 换道　↑ 跳跃　↓ 滑铲 · 手机可滑动屏幕</div></div>
<div id="controls"><div class="group"><button data-a="left">←</button><button data-a="right">→</button></div><div class="group"><button data-a="jump">↑</button><button data-a="slide">↓</button></div></div>
<div class="overlay" id="start"><div class="panel"><div class="kicker">ENDLESS RUNNER · 01</div><h1>霓虹疾行</h1><div style="color:#ffcf70;font-weight:900;letter-spacing:3px">NEON DASH</div><p class="sub">冲进未来都市，在三条轨道间闪避障碍、收集金币。跑得越远，速度越快！</p><div class="keys"><div><b>↔</b>左右换道</div><div><b>↑</b>跳过路障</div><div><b>↓</b>滑过横杆</div></div><button class="primary" id="go">开始跑酷</button><div class="small" style="margin-top:12px">原创网页版小游戏 · 无需安装</div></div></div>
<div class="overlay hidden" id="over"><div class="panel"><div class="kicker">RUN COMPLETE</div><h1 style="font-size:42px">冲刺结束</h1><p class="sub">再试一次，刷新你的最佳纪录！</p><div style="display:flex;justify-content:space-around;margin:18px 0"><div>本次距离<br><strong id="final" style="font-size:26px;color:#4df4ff">0</strong></div><div>收集金币<br><strong id="fcoins" style="font-size:26px;color:#ffd76a">0</strong></div><div>最佳纪录<br><strong id="best" style="font-size:26px;color:#ff76d7">0</strong></div></div><button class="primary" id="again">再跑一次</button><button class="secondary" id="home">返回标题</button></div></div></div>
<script>
(()=>{const c=document.querySelector('#game'),x=c.getContext('2d'),$=id=>document.getElementById(id);let W,H,D=1,state='ready',last=0,time=0,dist=0,money=0,speed=.42,spawn=0,coinTimer=0,offset=0,lane=1,jump=0,jv=0,slide=0,obs=[],coins=[],bits=[],stars=[],best=0;try{best=+(localStorage.neonDashBest||0)}catch(e){}
const rnd=(a,b)=>a+Math.random()*(b-a);function resize(){let r=c.getBoundingClientRect();W=r.width;H=r.height;D=Math.min(devicePixelRatio||1,2);c.width=W*D;c.height=H*D;x.setTransform(D,0,0,D,0,0);stars=Array.from({length:80},()=>({x:Math.random()*W,y:Math.random()*H*.55,r:rnd(.5,1.7),a:rnd(.2,.8)}))}window.addEventListener('resize',resize);resize();
function project(l,d){let t=Math.max(0,Math.min(1,d)),y=H*.31+(H*.94-H*.31)*t,half=W*(.035+.47*t);return{x:W/2+(l-1)*half*.58,y,s:.12+.95*t,half}}
function rr(a,b,w,h,r){x.beginPath();x.roundRect(a,b,w,h,r);x.fill()}
function bg(){let g=x.createLinearGradient(0,0,0,H);g.addColorStop(0,'#071126');g.addColorStop(.55,'#17395b');g.addColorStop(1,'#091321');x.fillStyle=g;x.fillRect(0,0,W,H);let glow=x.createRadialGradient(W/2,H*.28,1,W/2,H*.28,W*.35);glow.addColorStop(0,'#ff4fc833');glow.addColorStop(1,'#ff4fc800');x.fillStyle=glow;x.fillRect(0,0,W,H);stars.forEach(s=>{x.globalAlpha=s.a;x.fillStyle='#b7f7ff';x.fillRect(s.x,s.y,s.r,s.r)});x.globalAlpha=1;
for(let i=0;i<24;i++){let bw=W/21,bh=H*(.08+((i*17)%9)/100),xx=i*bw*.92;x.fillStyle=i%3?'#0a1d35':'#142d4b';x.fillRect(xx,H*.31-bh,bw,bh);x.fillStyle='#39d9ff55';for(let yy=H*.31-bh+8;yy<H*.30;yy+=10)x.fillRect(xx+5,yy,2,3)}
let hy=H*.31,bot=H*1.06;x.fillStyle='#101a2b';x.beginPath();x.moveTo(W*.46,hy);x.lineTo(W*.54,hy);x.lineTo(W*.99,bot);x.lineTo(W*.01,bot);x.fill();x.strokeStyle='#42efff';x.lineWidth=2;x.shadowBlur=14;x.shadowColor='#28ddff';[-1,1].forEach(s=>{x.beginPath();x.moveTo(W/2+s*W*.04,hy);x.lineTo(W/2+s*W*.49,bot);x.stroke()});x.shadowBlur=0;
for(let i=0;i<14;i++){let t=((i/14+offset)%1),y=hy+(bot-hy)*t,h=W*(.04+.45*t);x.strokeStyle=`rgba(95,201,235,${.12+.45*t})`;x.lineWidth=1+4*t;x.beginPath();x.moveTo(W/2-h,y);x.lineTo(W/2+h,y);x.stroke()}x.strokeStyle='#ff4fc8';x.globalAlpha=.4;x.beginPath();x.moveTo(W/2-W*.013,hy);x.lineTo(W/2-W*.16,bot);x.moveTo(W/2+W*.013,hy);x.lineTo(W/2+W*.16,bot);x.stroke();x.globalAlpha=1}
function player(){let p=project(lane,.88),s=Math.min(W/360,1.4)*Math.min(H/620,1.2),y=H*.83-jump;x.save();x.translate(p.x,y);x.scale(s,s);x.fillStyle='#0008';x.beginPath();x.ellipse(0,25+jump*.1,24,7,0,0,7);x.fill();if(slide>0){x.fillStyle='#36e7ff';rr(-25,-4,48,16,8);x.fillStyle='#ffd0a5';x.beginPath();x.arc(18,-9,10,0,7);x.fill();x.fillStyle='#15263e';x.fillRect(-23,7,44,7)}else{x.strokeStyle='#17223b';x.lineWidth=9;x.lineCap='round';x.beginPath();x.moveTo(-7,7);x.lineTo(-12,22);x.moveTo(7,7);x.lineTo(12,22);x.stroke();x.fillStyle='#17263e';rr(-18,17,14,7,3);rr(5,17,14,7,3);x.fillStyle='#35eaff';rr(-15,-21,30,32,9);x.fillStyle='#ff4fc8';rr(-12,-17,24,24,7);x.strokeStyle='#ffd0a5';x.lineWidth=6;x.beginPath();x.moveTo(-13,-15);x.lineTo(-21,-1);x.moveTo(13,-15);x.lineTo(21,-4);x.stroke();x.fillStyle='#e9ad8e';x.fillRect(-4,-27,8,8);x.fillStyle='#f1c2a0';x.beginPath();x.arc(0,-34,12,0,7);x.fill();x.fillStyle='#15223a';x.beginPath();x.arc(0,-38,12,Math.PI,Math.PI*2);x.fill();x.fillRect(-6,-35,3,2);x.fillRect(3,-35,3,2)}x.restore()}
function obstacle(o){let p=project(o.l,o.d),s=p.s;x.save();x.translate(p.x,p.y);x.scale(s,s);if(o.t==='block'){x.fillStyle='#172b47';rr(-25,-52,50,52,6);x.fillStyle='#ff4fc8';x.fillRect(-25,-52,50,7);x.fillStyle='#39efff';x.fillRect(-18,-37,36,4);x.fillStyle='#0a1222';x.fillRect(-17,-24,34,18)}else if(o.t==='bar'){x.fillStyle='#ff4fc8';x.fillRect(-34,-53,68,9);x.fillStyle='#263958';x.fillRect(-28,-44,7,44);x.fillRect(21,-44,7,44);x.fillStyle='#ffd76a';x.fillRect(-34,-53,68,3)}else{x.fillStyle='#172b47';rr(-34,-20,68,20,5);x.fillStyle='#ffd76a';x.fillRect(-28,-16,56,5)}x.restore()}
function coin(o){let p=project(o.l,o.d);x.save();x.translate(p.x,p.y-25*p.s);x.scale(p.s,p.s);x.shadowBlur=15;x.shadowColor='#ffd76a';x.fillStyle='#ffd76a';x.beginPath();x.arc(0,0,10,0,7);x.fill();x.fillStyle='#fff0a8';x.beginPath();x.arc(0,0,6,0,7);x.fill();x.restore()}
function puff(px,py,col){for(let i=0;i<8;i++)bits.push({x:px,y:py,vx:rnd(-90,90),vy:rnd(-130,30),life:rnd(.25,.55),col})}
function spawnObs(){obs.push({l:Math.floor(Math.random()*3),d:.04,t:['block','bar','gap'][Math.floor(Math.random()*3)],hit:false})}function spawnCoins(){let l=Math.floor(Math.random()*3);for(let i=0;i<5;i++)coins.push({l,d:.02-i*.075,got:false})}
function act(a){if(state!=='playing')return;if(a==='left')lane=Math.max(0,lane-1);if(a==='right')lane=Math.min(2,lane+1);if(a==='jump'&&jump<=0&&slide<=0)jv=560;if(a==='slide'&&jump<12)slide=.65}
function update(dt){if(state!=='playing')return;time+=dt;speed=Math.min(.42+time*.008,.82);dist+=dt*speed*100;offset=(offset+dt*speed*1.5)%1;spawn+=dt;coinTimer+=dt;if(spawn>Math.max(.58,1.22-time*.006)){spawn=0;spawnObs()}if(coinTimer>1.55){coinTimer=0;spawnCoins()}if(jv!==0||jump>0){jump+=jv*dt;jv-=1450*dt;if(jump<=0){jump=0;jv=0}}if(slide>0)slide=Math.max(0,slide-dt);
for(let o of obs){o.d+=dt*speed*.65;if(!o.hit&&o.d>.82&&o.d<.96&&o.l===lane){let safe=o.t==='block'?jump>58:o.t==='bar'?slide>0:jump>45;if(!safe){o.hit=true;end();return}else{o.hit=true;puff(project(lane,.88).x,H*.83,'#4df4ff')}}}obs=obs.filter(o=>o.d<1.12);
for(let q of coins){q.d+=dt*speed*.65;if(!q.got&&q.d>.83&&q.d<.96&&q.l===lane){q.got=true;money++;puff(project(lane,.88).x,H*.8,'#ffd76a')}}coins=coins.filter(q=>q.d<1.08&&!q.got);for(let p of bits){p.x+=p.vx*dt;p.y+=p.vy*dt;p.vy+=240*dt;p.life-=dt}bits=bits.filter(p=>p.life>0);$('score').textContent=Math.floor(dist);$('coins').textContent=money}
function draw(){bg();obs.slice().sort((a,b)=>a.d-b.d).forEach(obstacle);coins.slice().sort((a,b)=>a.d-b.d).forEach(coin);player();bits.forEach(p=>{x.globalAlpha=Math.max(0,p.life*2);x.fillStyle=p.col;x.fillRect(p.x,p.y,3,3)});x.globalAlpha=1}
function loop(t){let dt=Math.min((t-last)/1000||0,.033);last=t;update(dt);draw();requestAnimationFrame(loop)}requestAnimationFrame(loop);
function start(){state='playing';time=dist=money=spawn=coinTimer=offset=0;speed=.42;lane=1;jump=jv=slide=0;obs=[];coins=[];bits=[];$('score').textContent='0';$('coins').textContent='0';$('start').classList.add('hidden');$('over').classList.add('hidden');$('pause').classList.remove('hidden')}
function end(){state='over';best=Math.max(best,Math.floor(dist));try{localStorage.neonDashBest=best}catch(e){}$('final').textContent=Math.floor(dist);$('fcoins').textContent=money;$('best').textContent=best;$('over').classList.remove('hidden');$('pause').classList.add('hidden')}
function pause(){if(state==='playing'){state='paused';$('start').classList.remove('hidden');$('start').querySelector('h1').textContent='游戏暂停';$('start').querySelector('.sub').textContent='准备好后继续冲刺。';$('go').textContent='继续游戏';$('pause').textContent='▶ 继续'}else if(state==='paused'){state='playing';$('start').classList.add('hidden');$('start').querySelector('h1').textContent='霓虹疾行';$('start').querySelector('.sub').textContent='冲进未来都市，在三条轨道间闪避障碍、收集金币。跑得越远，速度越快！';$('go').textContent='开始跑酷';$('pause').textContent='Ⅱ 暂停'}}
$('go').onclick=()=>state==='paused'?pause():start();$('again').onclick=start;$('home').onclick=()=>{state='ready';$('over').classList.add('hidden');$('start').classList.remove('hidden');$('pause').classList.add('hidden')};$('pause').onclick=pause;document.querySelectorAll('[data-a]').forEach(b=>b.onclick=()=>act(b.dataset.a));window.addEventListener('keydown',e=>{let m={ArrowLeft:'left',a:'left',ArrowRight:'right',d:'right',ArrowUp:'jump',' ':'jump',w:'jump',ArrowDown:'slide',s:'slide'};if(m[e.key]){e.preventDefault();if(state==='ready'&&m[e.key]==='jump')start();else act(m[e.key])}if(e.key==='Escape'&&state==='playing')pause()});let touch=null;c.addEventListener('pointerdown',e=>touch={x:e.clientX,y:e.clientY});c.addEventListener('pointerup',e=>{if(!touch)return;let dx=e.clientX-touch.x,dy=e.clientY-touch.y;touch=null;if(state==='ready'){start();return}if(state!=='playing')return;if(Math.max(Math.abs(dx),Math.abs(dy))<22)act('jump');else if(Math.abs(dx)>Math.abs(dy))act(dx<0?'left':'right');else act(dy<0?'jump':'slide')});
})();
</script></body></html>
